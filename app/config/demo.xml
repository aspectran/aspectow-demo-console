<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE aspectran PUBLIC "-//ASPECTRAN//DTD Aspectran 9.0//EN"
        "https://aspectran.com/dtd/aspectran-9.dtd">
<aspectran>

    <bean id="demoScheduler" class="com.aspectran.core.scheduler.support.QuartzSchedulerFactoryBean">
        <property type="properties" name="quartzProperties">
            <entry name="org.quartz.scheduler.instanceName">DemoScheduler</entry>
            <entry name="org.quartz.scheduler.skipUpdateCheck">true</entry>
            <entry name="org.quartz.scheduler.makeSchedulerThreadDaemon">true</entry>
            <entry name="org.quartz.threadPool.makeThreadsDaemons">true</entry>
            <entry name="org.quartz.threadPool.threadCount">1</entry>
            <entry name="org.quartz.threadPool.threadsInheritContextClassLoaderOfInitializingThread">true</entry>
        </property>
    </bean>

</aspectran>

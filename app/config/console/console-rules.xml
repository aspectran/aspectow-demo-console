<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE aspectran PUBLIC "-//ASPECTRAN//DTD Aspectran 9.0//EN"
        "https://aspectran.com/dtd/aspectran-9.dtd">
<aspectran>

    <environment>
        <properties profile="prod">
            <item name="aspectow.console.portalUrl">https://public.aspectran.com/</item>
        </properties>
        <properties profile="!prod">
            <item name="aspectow.console.portalUrl">http://localhost:8080/</item>
        </properties>
    </environment>

    <append file="/config/console/node-rules.xml"/>
    <append file="/config/console/appmon-rules.xml"/>

</aspectran>

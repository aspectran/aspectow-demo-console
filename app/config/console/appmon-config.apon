# Polling configuration used only when WebSocket is not supported
pollingConfig: {
    # The interval in milliseconds at which the client polls the server for new messages
    pollingInterval: 3000
    # The duration in milliseconds after which an inactive polling session expires
    sessionTimeout: 30000
}
app: {
    id: console-console
    title: Console
    hidden: true
    event: {
        id: activity
        target: console
        parameters: {
            +: /**
            -: /nodes/**/polling/**  # Ignore polling requests
        }
    }
    event: {
        id: session
        target: tow.server/console
        parameters: {
            usernameAttribute: USER_INFO.username
        }
    }
    log: {
        id: app
        file: console.log
        sampleInterval: 300
        lastLines: 100
    }
    log: {
        id: access
        file: console-access.log
        sampleInterval: 300
        lastLines: 100
    }
}
app: {
    id: console-root
    title: Console Root
    hidden: true
    event: {
        id: activity
        target: root
        parameters: {
            +: /**
        }
    }
    event: {
        id: session
        target: tow.server/root
    }
    metric: {
        id: heap
        title: Heap
        description: Shows JVM Heap memory usage status
        reader: com.aspectran.aspectow.appmon.engine.exporter.metric.jvm.HeapMemoryUsageReader
        sampleInterval: 500
        heading: true
    }
    metric: {
        id: undertow-tp
        title: Undertow TP
        description: Metrics of Undertow thread pool resources
        reader: com.aspectran.aspectow.appmon.engine.exporter.metric.undertow.NioWorkerMetricsReader
        target: tow.server
        sampleInterval: 30
        exportInterval: 900
        heading: true
    }
    log: {
        id: app
        title: Root App
        file: /logs/root.log
        lastLines: 300
        sampleInterval: 300
    }
    log: {
        id: access
        title: Root Access
        file: /logs/root-access.log
        lastLines: 100
        sampleInterval: 300
    }
}
